#!name = FreshGuard 5.1.0 本地登录响应
#!desc = 请求阶段读取发包整数，将预设JSON加密并直接返回HTTP200，不连接登录服务器。需导入同名JS并启用MitM。
#!author = Local
#!date = 2026-11-11

[Script]
http-request ^https:\/\/api\.ios222\.com\/device\/login(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/efzb-wx/pluginln/refs/heads/main/freshguard_login.js, requires-body=true, timeout=10, tag=FreshGuard登录请求

[Mitm]
hostname = api.ios222.com
